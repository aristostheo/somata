{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env*",
        ".secret*",
        "*.local"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/staging-deploy-guard.cjs\"",
        "pnpm --prefix \"$RESOURCE_DIR\" install --frozen-lockfile",
        "pnpm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/staging-deploy-guard.cjs\""
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/staging-deploy-guard.cjs\""
    ]
  }
}

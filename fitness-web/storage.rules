rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Current app has no user upload feature. Tool-generated catalog media is public;
    // only Admin tooling may write it. Unknown objects must not be exposed or mutated.
    match /public/exercises.seed.json { allow read: if true; allow write: if false; }
    match /exercises/{exerciseId}/demo.gif { allow read: if true; allow write: if false; }
    match /{path=**} { allow read, write: if false; }
  }
}

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    // SDK 58's supported compatibility mode for existing RN/Moti component types.
    // Migrate these together before React Native removes the legacy type surface.
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node", "react", "react-native", "expo-router"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "app/old",
    "components/scanMeal/old",
    "components/nutrition/new(ALL NOT USED)",
    "**/*(old)*"
  ]
}

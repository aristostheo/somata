{
  "cli": {
    "version": ">= 16.24.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "environment": "preview",
      "channel": "testflight-staging",
      "env": {
        "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "false",
        "SOMATA_RELEASE_BUILD": "true",
        "SOMATA_CHECKOUT_ENABLED": "false",
        "EXPO_PUBLIC_SOMATA_BACKEND_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}

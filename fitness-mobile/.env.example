# AI uses the authenticated generateSomataAI Firebase callable.
# Configure OPENAI_API_KEY only as a Functions secret, never in an Expo environment variable.

# Off for personal-account use and all release builds.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false

# Optional public Google OAuth client IDs, configured separately for each platform.
# Leave unset until real clients and their redirect URIs have been verified.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public release configuration, read by app.config.ts and embedded in extra.release.
# Required for TestFlight/production: supply real operator-owned HTTPS destinations.
# SOMATA_PRIVACY_POLICY_URL=
# SOMATA_SUPPORT_URL=
# Leave checkout off until its authenticated backend/payment lifecycle is implemented.
SOMATA_CHECKOUT_ENABLED=false
# EXPO_PUBLIC_STRIPE_PRICE_ID=
# For local store-config/OTA validation outside EAS, set SOMATA_RELEASE_BUILD=true.

# TestFlight is staging-only. Missing values block config/build; no production fallback.
# The testflight EAS profile sets EXPO_PUBLIC_SOMATA_BACKEND_ENV=staging.
# For local staging previews, explicitly set it together with these operator inputs:
# EXPO_PUBLIC_SOMATA_BACKEND_ENV=staging
# EXPO_PUBLIC_SOMATA_STAGING_PROJECT_ID=
# SOMATA_STAGING_FIREBASE_CONFIG=
# The JSON above contains exactly: apiKey, authDomain, projectId, storageBucket,
# messagingSenderId, appId, copied from the staging project's Firebase web app.
# These are public client settings. NEVER put server/provider secrets in this JSON.
